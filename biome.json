{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "files": {
        "includes": [
            "**",
            "!dist",
            "!.astro",
            "!.cache",
            "!test-results",
            "!playwright-report",
            "!.hallmark",
            "!.claude",
            "!screenshots",
            "!scrollcraft"
        ]
    },
    "formatter": { "indentStyle": "space", "indentWidth": 4, "lineWidth": 120 },
    "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" } },
    "css": { "parser": { "tailwindDirectives": true } },
    "linter": {
        "enabled": true,
        "rules": { "preset": "recommended", "style": { "useImportType": "error", "useBlockStatements": "error" } }
    },
    "overrides": [
        {
            "includes": ["**/*.astro"],
            "linter": {
                "rules": {
                    "correctness": { "noUnusedVariables": "off", "noUnusedImports": "off" },
                    "style": { "useConst": "off", "useImportType": "off" }
                }
            }
        }
    ]
}
