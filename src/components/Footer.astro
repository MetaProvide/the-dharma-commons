        <p class="colophon__line">{t('footer_line')}</p>
        <ul class="colophon__links">
            <li><a href="/#teachings">{t('nav_teachings')}</a></li>
            <li><a href="/how-it-works">{t('nav_how')}</a></li>
            <li><a href="/about">{t('nav_about')}</a></li>
            <li><a href="/contribute">{t('nav_contribute')}</a></li>
        </ul>
        <p class="colophon__credit">
            <a href="https://metaprovide.org/archive/" rel="noopener">{t('footer_powered')}</a>
            <span>{t('footer_swarm')}</span>
            <span>{t('footer_privacy')}</span>
        </p>
    </div>
</footer>
